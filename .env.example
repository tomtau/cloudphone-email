# Gmail OAuth 2.0 Client ID (from Google Cloud Console)
VITE_GMAIL_CLIENT_ID=

# Microsoft Azure AD Application Client ID
VITE_MICROSOFT_CLIENT_ID=

# JMAP session URL (e.g. https://api.fastmail.com/jmap/session for FastMail)
VITE_JMAP_SESSION_URL=

# JMAP authentication token (e.g. FastMail app password or API token)
VITE_JMAP_AUTH_TOKEN=
